def separator(char="=", width=60):
    print(char * width)


def print_header():
    separator()
    print("  INCIDENT RESPONSE SIMULATOR")
    print("  Author: Mark Robinson | CompTIA Security+")
    print("  Framework: NIST SP 800-61")
    separator()


def phase_1_detection():
    """Phase 1 - Detection & Initial Triage."""
    print("\n")
    separator()
    print("  PHASE 1 — DETECTION & INITIAL TRIAGE")
    separator()
    print(f"\n ALERT RECEIVED")
    print(f"     Incident ID:    {INCIDENT['id']}")
    print(f"     Time Detected:  {INCIDENT['detected']}")
    print(f"     Alert Name:     {INCIDENT['alert_name']}")
    print(f"     Detected By:    {INCIDENT['reported_by']}")
    print(f"     Affected Host:  {INCIDENT['affected_host']}")
    print(f"     Affected User:  {INCIDENT['affected_user']}")
    print(f"     Source IP:      {INCIDENT['src_ip']}")


def phase_2_classification():
    """Phase 2 - Severity Classification."""
    print("\n")
    separator()
    print("  PHASE 2 — SEVERITY CLASSIFICATION")
    separator()

    criteria = [
        ("Ransomware / destructive malware detected", True),
        ("Active file encryption in progress",        True),
        ("Lateral movement attempted",                True),
        ("Multiple systems potentially affected",     True),
        ("Sensitive data exfiltration suspected",     True),
    ]

    print("\n  Classification Criteria:")
    score = 0
    for criterion, met in criteria:
        status = "YES" if met else "NO"
        print(f"     {status} — {criterion}")
        if met:
            score += 1

    severity = "P1 — CRITICAL" if score >= 4 else \
               "P2 — HIGH"     if score >= 3 else \
               "P3 — MEDIUM"   if score >= 2 else \
               "P4 — LOW"

    print(f"\n  ⚡ SEVERITY CLASSIFICATION: {severity}")
    print(f"     Score: {score}/5 criteria met")
    print(f"     MITRE: T1566 (Phishing) → T1078 (Valid Accounts) → T1486 (Ransomware)")
    return severity


def phase_3_iocs():
    """Phase 3 - IOC Identification."""
    print("\n")
    separator()
    print("  PHASE 3 — INDICATORS OF COMPROMISE (IOCs)")
    separator()
    print()
    for ioc in IOCS:
        print(f"  [{ioc['confidence']}] {ioc['type']}")
        print(f"         {ioc['value']}\n")

    print("  Action: Add all HIGH confidence IOCs to:")
    print("     - Firewall blocklist")
    print("     - EDR platform threat indicators")
    print("     - SIEM watchlist for lateral spread detection")


def phase_4_timeline():
    """Phase 4 - Incident Timeline."""
    print("\n")
    separator()
    print("  PHASE 4 — INCIDENT TIMELINE")
    separator()
    print()
    for timestamp, event in TIMELINE:
        print(f"  {timestamp}  |  {event}")


def phase_5_containment(severity):
    """Phase 5 - Containment Actions."""
    print("\n")
    separator()
    print("  PHASE 5 — CONTAINMENT PLAYBOOK")
    separator()

    print(f"\n  Executing playbook for: {severity}\n")
    for i, action in enumerate(PLAYBOOK[severity], 1):
        print(f"  {i:02d}. {action}")

    print(f"\n  Additional Containment Steps:")
    for i, action in enumerate(PLAYBOOK["Containment"], 1):
        print(f"  {i:02d}. {action}")


