import random
from datetime import datetime, timedelta
from collections import defaultdict


# --- Thresholds (tunable detection rules) ---
PORT_SCAN_THRESHOLD = 15       # Unique ports from single IP = port scan
LARGE_TRANSFER_MB = 50         # MB threshold for suspicious data transfer
SUSPICIOUS_PORTS = {4444, 1337, 31337, 8888, 9999}  # Common C2/malware ports
INTERNAL_SUBNET = "192.168."
ANALYSIS_WINDOW_MINUTES = 10   # Time window for port scan detection


def generate_traffic():
    """Generate simulated network traffic including attack scenarios."""
    traffic = []
    internal_ips = [f"192.168.1.{i}" for i in range(10, 30)]
    external_ips = [f"203.{random.randint(1,254)}.{random.randint(1,254)}.{random.randint(1,254)}"
                    for _ in range(10)]
    common_ports = [80, 443, 22, 53, 25, 143, 3389, 8080]
    attacker_ip = "192.168.1.105"
    exfil_ip = "45.33.32.156"  # Simulated external attacker

    base_time = datetime.now() - timedelta(hours=1)

    # Normal traffic
    for i in range(300):
        traffic.append({
            "timestamp": (base_time + timedelta(seconds=i * 12)).strftime("%Y-%m-%d %H:%M:%S"),
            "src_ip": random.choice(internal_ips),
            "dest_ip": random.choice(external_ips),
            "dest_port": random.choice(common_ports),
            "protocol": "TCP",
            "bytes": random.randint(1000, 5000000),
            "direction": "outbound"
        })

    # ATTACK 1: Port scan
    scan_time = base_time + timedelta(minutes=15)
    for port in random.sample(range(20, 500), 40):
        scan_time += timedelta(seconds=random.randint(1, 3))
        traffic.append({
            "timestamp": scan_time.strftime("%Y-%m-%d %H:%M:%S"),
            "src_ip": attacker_ip,
            "dest_ip": "192.168.1.20",
            "dest_port": port,
            "protocol": "TCP",
            "bytes": 0,
            "direction": "internal"
        })

    # ATTACK 2: Large data transfer (potential exfiltration)
    exfil_time = base_time + timedelta(minutes=30)
    traffic.append({
        "timestamp": exfil_time.strftime("%Y-%m-%d %H:%M:%S"),
        "src_ip": "192.168.1.15",
        "dest_ip": exfil_ip,
        "dest_port": 443,
        "protocol": "TCP",
        "bytes": 85 * 1024 * 1024,  # 85MB
        "direction": "outbound"
    })

    # ATTACK 3: Suspicious C2 port communication
    c2_time = base_time + timedelta(minutes=45)
    for _ in range(8):
        c2_time += timedelta(minutes=random.randint(1, 3))
        traffic.append({
            "timestamp": c2_time.strftime("%Y-%m-%d %H:%M:%S"),
            "src_ip": "192.168.1.22",
            "dest_ip": exfil_ip,
            "dest_port": random.choice(list(SUSPICIOUS_PORTS)),
            "protocol": "TCP",
            "bytes": random.randint(500, 2000),
            "direction": "outbound"
        })

    return traffic


def detect_port_scans(traffic):
    """Detect hosts scanning multiple ports."""
    print("\n" + "="*60)
    print("  DETECTION 1: PORT SCAN ANALYSIS")
    print("="*60)

    port_map = defaultdict(set)
    for conn in traffic:
        port_map[conn["src_ip"]].add(conn["dest_port"])

    findings = []
    for ip, ports in port_map.items():
        if len(ports) >= PORT_SCAN_THRESHOLD:
            findings.append({
                "src_ip": ip,
                "unique_ports": len(ports),
                "severity": "HIGH" if len(ports) > 30 else "MEDIUM"
            })

    if findings:
        for f in sorted(findings, key=lambda x: x["unique_ports"], reverse=True):
            print(f"\n  PORT SCAN DETECTED")
            print(f"     Source IP:     {f['src_ip']}")
            print(f"     Ports Scanned: {f['unique_ports']}")
            print(f"     Severity:      {f['severity']}")
            print(f"     MITRE:         T1046 - Network Service Scanning")
            print(f"     Action:        Block source IP, investigate host")
    else:
        print("   No port scans detected")

    return findings


def detect_large_transfers(traffic):
    """Detect unusually large data transfers."""
    print("\n" + "="*60)
    print("  DETECTION 2: LARGE DATA TRANSFER ANALYSIS")
    print("="*60)

    transfer_map = defaultdict(int)
    for conn in traffic:
        if conn["direction"] == "outbound":
            key = (conn["src_ip"], conn["dest_ip"])
            transfer_map[key] += conn["bytes"]

    findings = []
    for (src, dest), total_bytes in transfer_map.items():
        total_mb = total_bytes / (1024 * 1024)
        if total_mb >= LARGE_TRANSFER_MB:
            findings.append({
                "src_ip": src,
                "dest_ip": dest,
                "total_mb": round(total_mb, 2),
                "severity": "CRITICAL" if total_mb > 75 else "HIGH"
            })

    if findings:
        for f in sorted(findings, key=lambda x: x["total_mb"], reverse=True):
            print(f"\n   LARGE TRANSFER DETECTED")
            print(f"     Source IP:    {f['src_ip']}")
            print(f"     Destination:  {f['dest_ip']}")
            print(f"     Data Volume:  {f['total_mb']} MB")
            print(f"     Severity:     {f['severity']}")
            print(f"     MITRE:        T1048 - Exfiltration Over Alternative Protocol")
            print(f"     Action:       Isolate host, capture full PCAP, notify IR team")
    else:
        print("  No large transfers detected")

    return findings


def detect_suspicious_ports(traffic):
    """Detect traffic on known suspicious/malware ports."""
    print("\n" + "="*60)
    print("  DETECTION 3: SUSPICIOUS PORT ANALYSIS")
    print("="*60)

    findings = []
    seen = set()
    for conn in traffic:
        if conn["dest_port"] in SUSPICIOUS_PORTS:
            key = (conn["src_ip"], conn["dest_ip"], conn["dest_port"])
            if key not in seen:
                seen.add(key)
                findings.append({
                    "src_ip": conn["src_ip"],
                    "dest_ip": conn["dest_ip"],
                    "port": conn["dest_port"],
                    "timestamp": conn["timestamp"],
                    "severity": "CRITICAL"
                })

    if findings:
        for f in findings:
            print(f"\n  SUSPICIOUS PORT COMMUNICATION")
            print(f"     Source IP:    {f['src_ip']}")
            print(f"     Destination:  {f['dest_ip']}")
            print(f"     Port:         {f['port']}")
            print(f"     First Seen:   {f['timestamp']}")
            print(f"     Severity:     {f['severity']}")
            print(f"     MITRE:        T1071 - Application Layer Protocol (C2)")
            print(f"     Action:       Isolate immediately, escalate to IR team")
    else:
        print(" No suspicious port usage detected")

    return findings


def print_executive_summary(scan_findings, transfer_findings, port_findings):
    """Print executive summary of all findings."""
    total_findings = len(scan_findings) + len(transfer_findings) + len(port_findings)
    critical = sum(1 for f in transfer_findings + port_findings
                   if f.get("severity") == "CRITICAL")

    print("\n" + "="*60)
    print("  EXECUTIVE SUMMARY")
    print("="*60)
    print(f"\n  Analysis Timestamp: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print(f"  Analyst:            Mark Robinson")
    print(f"\n  Total Findings:     {total_findings}")
    print(f"  Critical:           {critical}")
    print(f"  High:               {total_findings - critical}")
    print(f"\n  Compromised Hosts:")

    all_ips = set()
    for f in scan_findings + transfer_findings + port_findings:
        all_ips.add(f["src_ip"])
    for ip in all_ips:
        print(f"    - {ip}")

    print(f"\n  Recommended Actions:")
    print(f"    1. Block attacker IP at perimeter firewall")
    print(f"    2. Isolate potentially compromised internal hosts")
    print(f"    3. Capture full PCAP for forensic analysis")
    print(f"    4. Reset credentials for affected users")
    print(f"    5. Escalate to Incident Response team")
    print(f"    6. File formal incident report")
    print("\n" + "="*60)


if __name__ == "__main__":
    print("\n" + "="*60)
    print("  Network Traffic Analyzer")
    print("  Author: Mark Robinson | Security+")
    print("="*60)
    print("\n[*] Generating simulated network traffic...")

    traffic = generate_traffic()
    print(f"[+] Generated {len(traffic)} network connections")
    print("[*] Running threat detection analysis...\n")

    scan_findings = detect_port_scans(traffic)
    transfer_findings = detect_large_transfers(traffic)
    port_findings = detect_suspicious_ports(traffic)
    print_executive_summary(scan_findings, transfer_findings, port_findings)
