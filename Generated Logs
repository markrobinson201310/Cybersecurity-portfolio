#!/usr/bin/env python3
"""
Log Generator for SIEM Detection Lab
Author: Mark Robinson 
Description: Generates realistic sample security logs for Splunk ingestion
             simulating brute force attacks, suspicious logins, and port scans.
"""

import csv
import random
from datetime import datetime, timedelta

# --- Configuration ---
OUTPUT_DIR = "."
NUM_NORMAL_EVENTS = 200
ATTACK_IP = "192.168.1.105"
INTERNAL_IPS = [f"192.168.1.{i}" for i in range(10, 50)]
USERNAMES = ["jsmith", "adoe", "bwilson", "mrobinson", "tjones", "klee"]
PORTS = [22, 80, 443, 3389, 8080, 8443, 21, 25, 53, 445]
SCAN_PORTS = list(range(20, 1025, 5))


def random_time(days_back=7, after_hours=False):
    """Generate a random timestamp, optionally during after-hours."""
    base = datetime.now() - timedelta(days=random.randint(0, days_back))
    if after_hours:
        hour = random.choice(list(range(22, 24)) + list(range(0, 6)))
    else:
        hour = random.randint(8, 18)
    return base.replace(
        hour=hour,
        minute=random.randint(0, 59),
        second=random.randint(0, 59)
    ).strftime("%Y-%m-%d %H:%M:%S")


def generate_auth_logs():
    """Generate authentication log data including brute force simulation."""
    print("[*] Generating authentication logs...")
    rows = []

    # Normal successful logins
    for _ in range(NUM_NORMAL_EVENTS):
        rows.append({
            "timestamp": random_time(),
            "src_ip": random.choice(INTERNAL_IPS),
            "user": random.choice(USERNAMES),
            "action": "success",
            "event_type": "authentication",
            "message": "User login successful"
        })

    # Normal failed logins (occasional)
    for _ in range(20):
        rows.append({
            "timestamp": random_time(),
            "src_ip": random.choice(INTERNAL_IPS),
            "user": random.choice(USERNAMES),
            "action": "failed",
            "event_type": "authentication",
            "message": "Invalid password"
        })

    # ATTACK: Brute force from ATTACK_IP (30 failed attempts)
    print(f"[*] Simulating brute force attack from {ATTACK_IP}...")
    for _ in range(30):
        rows.append({
            "timestamp": random_time(days_back=1),
            "src_ip": ATTACK_IP,
            "user": "administrator",
            "action": "failed",
            "event_type": "authentication",
            "message": "Invalid password - possible brute force"
        })

    # ATTACK: After-hours successful login (suspicious)
    print("[*] Simulating after-hours suspicious login...")
    for _ in range(5):
        rows.append({
            "timestamp": random_time(days_back=2, after_hours=True),
            "src_ip": ATTACK_IP,
            "user": random.choice(USERNAMES),
            "action": "success",
            "event_type": "authentication",
            "message": "User login successful - AFTER HOURS"
        })

    # Write to CSV
    random.shuffle(rows)
    filepath = f"{OUTPUT_DIR}/auth_logs.csv"
    with open(filepath, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=rows[0].keys())
        writer.writeheader()
        writer.writerows(rows)
    print(f"[+] Auth logs written to {filepath} ({len(rows)} events)")
    return filepath


def generate_network_logs():
    """Generate network connection logs including port scan simulation."""
    print("[*] Generating network logs...")
    rows = []

    # Normal network connections
    for _ in range(NUM_NORMAL_EVENTS):
        rows.append({
            "timestamp": random_time(),
            "src_ip": random.choice(INTERNAL_IPS),
            "dest_ip": f"10.0.0.{random.randint(1, 50)}",
            "dest_port": random.choice(PORTS),
            "protocol": random.choice(["TCP", "UDP"]),
            "event_type": "connection",
            "bytes_sent": random.randint(100, 50000),
            "action": "allowed"
        })

    # ATTACK: Port scan from ATTACK_IP
    print(f"[*] Simulating port scan from {ATTACK_IP}...")
    scan_time = datetime.now() - timedelta(hours=2)
    for port in random.sample(SCAN_PORTS, 50):
        scan_time += timedelta(seconds=random.randint(1, 5))
        rows.append({
            "timestamp": scan_time.strftime("%Y-%m-%d %H:%M:%S"),
            "src_ip": ATTACK_IP,
            "dest_ip": "192.168.1.20",
            "dest_port": port,
            "protocol": "TCP",
            "event_type": "connection",
            "bytes_sent": 0,
            "action": "allowed"
        })

    # Write to CSV
    random.shuffle(rows)
    filepath = f"{OUTPUT_DIR}/network_logs.csv"
    with open(filepath, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=rows[0].keys())
        writer.writeheader()
        writer.writerows(rows)
    print(f"[+] Network logs written to {filepath} ({len(rows)} events)")
    return filepath


def generate_system_logs():
    """Generate system event logs."""
    print("[*] Generating system logs...")
    events = [
        "Service started",
        "Service stopped",
        "File accessed",
        "Registry modified",
        "Process created",
        "Scheduled task executed",
        "User account modified",
        "Firewall rule changed"
    ]
    severities = ["INFO", "INFO", "INFO", "WARNING", "WARNING", "ERROR"]
    rows = []

    for _ in range(NUM_NORMAL_EVENTS):
        rows.append({
            "timestamp": random_time(),
            "host": f"WORKSTATION-{random.randint(1, 20):02d}",
            "event_type": "system",
            "severity": random.choice(severities),
            "event": random.choice(events),
            "user": random.choice(USERNAMES),
            "process": random.choice([
                "explorer.exe", "chrome.exe", "svchost.exe",
                "powershell.exe", "cmd.exe", "python.exe"
            ])
        })

    # Suspicious: PowerShell execution from attack IP timeframe
    rows.append({
        "timestamp": random_time(days_back=1, after_hours=True),
        "host": "WORKSTATION-07",
        "event_type": "system",
        "severity": "WARNING",
        "event": "Suspicious PowerShell execution detected",
        "user": "administrator",
        "process": "powershell.exe"
    })

    random.shuffle(rows)
    filepath = f"{OUTPUT_DIR}/system_logs.csv"
    with open(filepath, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=rows[0].keys())
        writer.writeheader()
        writer.writerows(rows)
    print(f"[+] System logs written to {filepath} ({len(rows)} events)")
    return filepath


def print_summary():
    """Print lab summary and next steps."""
    print("\n" + "="*60)
    print("  LOG GENERATION COMPLETE")
    print("="*60)
    print("\n📁 Files Created:")
    print("  - auth_logs.csv    (authentication events)")
    print("  - network_logs.csv (network connection events)")
    print("  - system_logs.csv  (system events)")
    print("\n🚨 Simulated Attacks:")
    print(f"  - Brute Force:     30 failed logins from {ATTACK_IP}")
    print(f"  - After-Hours:     Suspicious logins 10pm-6am from {ATTACK_IP}")
    print(f"  - Port Scan:       50 ports scanned from {ATTACK_IP}")
  

if __name__ == "__main__":
    print("\n" + "="*60)
    print("  SIEM Detection Lab - Log Generator")
    print("  Author: Mark Robinson | Security+")
    print("="*60 + "\n")

    generate_auth_logs()
    generate_network_logs()
    generate_system_logs()
    print_summary()
